{
  "name": "dsh-sesame",
  "version": "0.1.7",
  "private": true,
  "description": "DSH-Sesame —— dsh 的桌面启动器（Electron + Vue 3 + TypeScript）",
  "author": "DSH-Sesame",
  "main": "./compiled/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "preview": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "check:market": "node scripts/check-market-version.mjs",
    "smoke:market": "node scripts/smoke-market.mjs",
    "check:graph": "node scripts/check-import-graph.mjs",
    "check:mirror": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-desktop-mirror.mjs",
    "check:update": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-update.mjs",
    "bundle:node": "node scripts/bundle-node.mjs",
    "pack": "npm run typecheck && npm run check:graph && npm run build && electron-builder --dir",
    "dist": "npm run typecheck && npm run check:graph && npm run build && electron-builder",
    "release": "node scripts/bundle-node.mjs && npm run dist && node scripts/publish-release.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/semver": "^7.8.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vue-tsc": "^3.3.11"
  },
  "allowScripts": {
    "electron@44.4.5": true,
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true,
    "electron-winstaller@5.4.0": true
  },
  "dependencies": {
    "dshmarket": "1.66.20",
    "pinia": "^4.0.3",
    "semver": "^7.8.5",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.12",
    "vue-router": "^5.3.1"
  }
}
